# Pinch runs with none of these set: the tool works, the AI steps are off,
# notes save to memory, and the owner's GET /api/pin/notes is open only in
# `next dev`. Copy to .env.local and fill in what you use. Never commit .env*.

# ---- AI steps (Anthropic) ---------------------------------------------------
# Turns on suggestions and rule drafts.
ANTHROPIC_API_KEY=
# "0" turns suggestions and rule drafts off even with a key.
PIN_AI=
# Suggestions: "0" turns them off; model and daily caps.
PIN_SUGGEST=
PIN_SUGGEST_MODEL=claude-haiku-5-5
PIN_SUGGEST_DAILY_USD=2
PIN_SUGGEST_PER_VISITOR=300
PIN_SUGGEST_CALLS_PER_DAY=4000
# Reading notes into rules: "0" turns it off; model and daily caps, a fair-use limit
# for everyone on top of the credits each update takes (D98).
PIN_LEARN=
PIN_LEARN_MODEL=claude-opus-5-5
PIN_TITLE_MODEL=claude-haiku-5-5
PIN_LEARN_DAILY_USD=10
PIN_LEARN_PER_VISITOR=60
PIN_LEARN_CALLS_PER_DAY=600

# ---- Saved notes (Vercel Blob) ----------------------------------------------
# Either turns on the private Blob store for ledgers and saved note text.
# Without both, everything is kept in memory and lost on restart.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Owner's read of the saved notes (GET /api/pin/notes). Unset: 404 in
# production, open in `next dev`.
ADMIN_PASSWORD=
# Salts the hashed visitor key in the daily ledgers. Any string; has a default.
VISITOR_SALT=

# ---- Selling Pinch (D81) ------------------------------------------------------
# Google sign-in: an OAuth client of type Web application, with the redirect
# URI https://<domain>/api/pin/auth/callback. AUTH_SECRET signs the session
# cookie (any long random string).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Lemon Squeezy: with the store, the credits product, the link and the secret
# set (and sign-in on), Pinch is paid. The webhook points at
# https://<domain>/api/pin/billing/webhook with the events order_created and
# order_refunded. PINCH_BUY_URL is the credits product's checkout (D98).
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_CREDITS_PRODUCT_ID=
PINCH_BUY_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
# The original offer ($19 once, D81): its buyers keep what they bought (D98).
LEMONSQUEEZY_PRODUCT_ID=
# Optional: lets "Paid already?" find a purchase by email.
LEMONSQUEEZY_API_KEY=
PINCH_PRICE=
PINCH_SUPPORT_EMAIL=
# Set by Vercel with the Blob store; uploads of the account's batches need it.
BLOB_WEBHOOK_PUBLIC_KEY=
# Local tests only: "1" turns on POST /api/pin/auth/test (never on Vercel).
PINCH_TEST_LOGIN=

# ---- Note tagging (Jev, TypeSafe) -------------------------------------------
# Tags saved notes by design area. Off without the key, or with PIN_TAGS=0.
JEV_API_KEY=
PIN_TAGS=
# Local stub: `pnpm jev-stub` then JEV_ENDPOINT=http://localhost:3999 JEV_API_KEY=stub
JEV_ENDPOINT=
JEV_MODEL=jev-1.13.0
PIN_TAG_CALLS_PER_DAY=2000
